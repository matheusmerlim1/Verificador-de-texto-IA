#!/bin/sh
# Bloqueia commit que contenha chave da Anthropic.
# Ativar:  git config core.hooksPath .githooks
if git diff --cached -U0 | grep -qE '^\+.*sk-ant-api[0-9]{2}-[A-Za-z0-9_-]{20,}'; then
  echo ""
  echo "  COMMIT BLOQUEADO"
  echo "  Uma chave da Anthropic (sk-ant-...) esta entre as alteracoes."
  echo ""
  echo "  Arquivo(s):"
  git diff --cached --name-only | while read f; do
    if grep -qE 'sk-ant-api[0-9]{2}-[A-Za-z0-9_-]{20,}' "$f" 2>/dev/null; then echo "    - $f"; fi
  done
  echo ""
  echo "  Esta e a copia PUBLICA: config.js deve ter apiKey: ''"
  echo "  A chave vive apenas na copia privada."
  echo ""
  exit 1
fi
exit 0
